{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Stop UtilMaster3000",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process UtilMaster3000 -ErrorAction SilentlyContinue | Stop-Process -Force; exit 0"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build UtilMaster3000",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/UtilMaster3000.csproj"
      ],
      "dependsOn": [
        "Stop UtilMaster3000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
